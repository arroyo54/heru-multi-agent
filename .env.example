# ─── Anthropic ───────────────────────────────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api...

# Modelo de Claude a usar (claude-opus-4-6 recomendado para producción)
# claude-haiku-4-5-20251001 para desarrollo/testing más rápido y económico
MODEL=claude-opus-4-6

# ─── Configuración del Sistema ───────────────────────────────────────────────
# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Máximo de tokens por respuesta de agente
MAX_TOKENS=4096

# ─── Integraciones Opcionales ────────────────────────────────────────────────
# CRM (HubSpot, Salesforce, etc.)
CRM_API_KEY=
CRM_BASE_URL=

# Meta Ads API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Social Listening Tools (Brandwatch, Mention, etc.)
SOCIAL_LISTENING_API_KEY=

# Generación de imágenes
OPENAI_API_KEY=  # Para DALL-E 3
STABILITY_API_KEY=  # Para Stable Diffusion
