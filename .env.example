# ─── Anthropic ───────────────────────────────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/
# En Railway: agregar como variable de entorno en el dashboard (no subir .env)
ANTHROPIC_API_KEY=sk-ant-api...

# Modelo de Claude a usar (claude-opus-4-6 recomendado para producción)
# claude-haiku-4-5-20251001 para desarrollo/testing más rápido y económico
MODEL=claude-opus-4-6

# ─── Configuración del Sistema ───────────────────────────────────────────────
# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Máximo de tokens por respuesta de agente
MAX_TOKENS=4096

# ─── Integraciones Opcionales ────────────────────────────────────────────────
# CRM (HubSpot, Salesforce, etc.)
CRM_API_KEY=
CRM_BASE_URL=

# Meta Ads API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Social Listening Tools (Brandwatch, Mention, etc.)
SOCIAL_LISTENING_API_KEY=

# Generación de imágenes con Google Imagen 3
# Obtén tu API key en: https://aistudio.google.com/app/apikey
# Sin esta key el agente de diseño sigue generando briefs pero no produce imágenes
GOOGLE_API_KEY=

# ─── Social Listener ─────────────────────────────────────────────────────────
# Apify — scraping de Twitter/X, TikTok, Instagram, Facebook, YouTube, Reddit, Quora
# Regístrate en: https://apify.com — free tier incluye $5 de créditos
APIFY_API_TOKEN=

# Google Chat — webhook del canal donde llega el reporte semanal
# En Google Chat: abre el canal → Editar → Aplicaciones y webhooks → Agregar webhook
GOOGLE_CHAT_WEBHOOK_URL=
